# ========================================================
# IntelliDesk - Root .gitignore
# ========================================================

# Dependencies
node_modules/
*/node_modules/

# Production Builds
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment & Sensitive Credentials
# Keep .env.example committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.local
*.pem
*.key
*.cert

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Playwright & Testing Artifacts
.playwright-mcp/
test-results/
playwright-report/
blob-report/
playwright/.cache/
dashboard_live_verification.png
incident_queue_live_verification.png
ai_root_cause_live_verification.png

# Keep official frontend showcase screenshots
!frontend/screenshots/
!frontend/screenshots/*.png

# IDE & OS Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database Backups & Dumps
*.dump
*.tar
*.bak

