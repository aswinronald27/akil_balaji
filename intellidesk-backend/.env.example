# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# When configured, IntelliDesk connects to PostgreSQL.
# If omitted or unconnectable, it automatically falls back to local database.json persistence.
DATABASE_URL=postgresql://intellidesk_owner:password@localhost:5432/intellidesk
PGHOST=localhost
PGPORT=5432
PGUSER=intellidesk_owner
PGPASSWORD=password
PGDATABASE=intellidesk

# Security & JWT
JWT_SECRET=supersecret_dev_key_change_in_production

